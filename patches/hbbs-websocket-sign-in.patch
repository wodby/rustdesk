+
+    async fn send_bytes_to_tcp_peer(
+        peers: &Arc<Mutex<HashMap<SocketAddr, Sink>>>,
+        peer_key: SocketAddr,
+        bytes: Vec<u8>,
+    ) -> bool {
+        let mut peers = peers.lock().await;
+        let Some(sink) = peers.get_mut(&peer_key) else {
+            return false;
+        };
+        let res = match sink {
+            Sink::TcpStream(s) => s.send(Bytes::from(bytes)).await.is_ok(),
+            Sink::Ws(ws) => ws.send(tungstenite::Message::Binary(bytes)).await.is_ok(),
+        };
+        if !res {
+            peers.remove(&peer_key);
+        }
+        res
+    }
