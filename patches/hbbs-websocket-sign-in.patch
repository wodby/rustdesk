+    /// Sends a message to a device signed in over TCP or WebSocket, keeping its connection.
+    async fn send_to_tcp_peer(
+        peers: &Arc<Mutex<HashMap<SocketAddr, Sink>>>,
+        peer_key: SocketAddr,
+        msg: RendezvousMessage,
