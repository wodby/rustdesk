+    /// Keeps a device signed in over this connection online while it answers.
+    async fn touch_tcp_peer(&self, registered: &Option<String>, peer_key: SocketAddr) {
+        if let Some(id) = registered {
+            if let Some(peer) = self.pm.get_in_memory(id).await {
+                let mut w = peer.write().await;
+                if w.socket_addr == peer_key {
+                    w.last_reg_time = Instant::now();
+                }
+            }
+        }
+    }
