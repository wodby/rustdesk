#!/usr/bin/env bash
# Prints the values to enter in the RustDesk app's ID/Relay server settings.

set -euo pipefail

key_file=/data/id_ed25519.pub

if [[ ! -s "${key_file}" ]]; then
    echo "The server hasn't created its key yet. Start the server and try again." >&2
    exit 1
fi

key="$(cat "${key_file}")"
host="${RUSTDESK_HOST:-<server address>}"

cat <<SETTINGS
In the RustDesk app on every device that uses this server, open Settings > Network:

1. Turn on Use WebSocket.
2. Under ID/Relay server, enter:

   ID server:    ${host}
   Relay server: leave empty
   API server:   https://${host}
   Key:          ${key}
SETTINGS

# Devices can also connect without WebSocket when the server's TCP and UDP ports are published.
if [[ -n "${RUSTDESK_ID_PORT:-}" && -n "${RUSTDESK_RELAY_PORT:-}" ]]; then
    cat <<SETTINGS

Devices with Use WebSocket turned off use these values instead:

   ID server:    ${host}:${RUSTDESK_ID_PORT}
   Relay server: ${host}:${RUSTDESK_RELAY_PORT}
   API server:   leave empty
   Key:          ${key}
SETTINGS
fi
